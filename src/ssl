#!/bin/bash

# 指定证书文件路径
cert_file="/path/to/your/certificate.crt"

# Linux (Ubuntu/Debian)
if [[ -f /etc/os-release && $(grep -i ubuntu /etc/os-release) ]]; then
  sudo cp "$cert_file" /usr/local/share/ca-certificates/
  sudo update-ca-certificates
# macOS
elif [[ $(uname -s) == "Darwin" ]]; then
  sudo security add-trusted-cert -d -r trustRoot -k /Library/Keychains/System.keychain "$cert_file"
# 其他Linux发行版，可尝试以下通用方法
else
  sudo cp "$cert_file" /etc/ssl/certs/
  # 更新证书，具体命令根据发行版不同而异
  # 例如：
  # sudo update-ca-certificates
  # sudo trust extract-pki --subject "/C=US/O=DigiCert Inc/CN=DigiCert Global Root CA"
fi


