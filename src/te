            if (!bResult)
            {
                printf("AuthzReportSecurityEvent failed, error is %d\n", err1);
                return_code = -2;
                break;
            }

            i++;
        }

        AuthzUnregisterSecurityEventSource(0, &hEventProvider);
        AuthzUninstallSecurityEventSource(0, &ws[0]);
    }
    return 0;
}

int __cdecl _tmain(int argc, TCHAR* argv[])
{
    if (argc > 1)
    {
        if (lstrcmpi(argv[1], TEXT("install")) == 0)
        {
            SvcInstall();
            return 0;
        }
        else if (lstrcmpi(argv[1], TEXT("uninstall")) == 0)
        {
            SvcUninstall();
            return 0;
        }
    }

    SERVICE_TABLE_ENTRY DispatchTable[] = {
        { (LPWSTR)SVCNAME, SvcMain },
        { NULL, NULL }
    };

    if (!StartServiceCtrlDispatcher(DispatchTable))
    {
        HandleError(TEXT("StartServiceCtrlDispatcher"), GetLastError());
    }

    return 0;
}

void SvcInstall()
{
    SC_HANDLE schSCManager = NULL;
    SC_HANDLE schService = NULL;
    TCHAR szPath[MAX_PATH];

    if (!GetModuleFileName(NULL, szPath, MAX_PATH))
    {
        HandleError(TEXT("GetModuleFileName"), GetLastError());
        return;
    }

    schSCManager = OpenSCManager(NULL, NULL, SC_MANAGER_ALL_ACCESS);
    if (schSCManager == NULL)
    {
        HandleError(TEXT("OpenSCManager"), GetLastError());
        return;
    }

    schService = CreateService(
        schSCManager,
        SVCNAME,
        SVCNAME,
        SERVICE_ALL_ACCESS,
        SERVICE_WIN32_OWN_PROCESS,
        SERVICE_DEMAND_START,
        SERVICE_ERROR_NORMAL,
        szPath,
        NULL, NULL, NULL, NULL, NULL);

    if (schService == NULL)
    {
        HandleError(TEXT("CreateService"), GetLastError());
    }
    else
    {
        _tprintf(TEXT("Service installed successfully.\\n"));
    }

    if (schService) CloseServiceHandle(schService);
    if (schSCManager) CloseServiceHandle(schSCManager);
}

void SvcUninstall()
{
    SC_HANDLE schSCManager = OpenSCManager(NULL, NULL, SC_MANAGER_ALL_ACCESS);
    if (!schSCManager)
    {
        HandleError(TEXT("OpenSCManager"), GetLastError());
        return;
    }

    SC_HANDLE schService = OpenService(schSCManager, SVCNAME, DELETE);
    if (!schService)
    {
        HandleError(TEXT("OpenService"), GetLastError());
    }
    else
    {
        if (!DeleteService(schService))
        {
            HandleError(TEXT("DeleteService"), GetLastError());
        }
        else
        {
            _tprintf(TEXT("Service uninstalled successfully.\\n"));
        }

        CloseServiceHandle(schService);
    }

    CloseServiceHandle(schSCManager);
}

void WINAPI SvcMain(DWORD dwArgc, LPTSTR* lpszArgv)
{
    gSvcStatusHandle = RegisterServiceCtrlHandler(SVCNAME, SvcCtrlHandler);
    if (!gSvcStatusHandle)
    {
        SvcReportEvent(LPTSTR("RegisterServiceCtrlHandler"));
        return;
    }

    gSvcStatus.dwServiceType = SERVICE_WIN32_OWN_PROCESS;
    gSvcStatus.dwServiceSpecificExitCode = 0;

    ReportSvcStatus(SERVICE_START_PENDING, NO_ERROR, 3000);
    SvcInit(dwArgc, lpszArgv);
}

void SvcInit(DWORD dwArgc, LPTSTR* lpszArgv)
{
    ghSvcStopEvent = CreateEvent(NULL, TRUE, FALSE, NULL);
    if (!ghSvcStopEvent)
    {
        ReportSvcStatus(SERVICE_STOPPED, GetLastError(), 0);
        return;
    }

    ReportSvcStatus(SERVICE_RUNNING, NO_ERROR, 0);
    write_log();
    while (WaitForSingleObject(ghSvcStopEvent, 0) != WAIT_OBJECT_0)
    {
        // Simulate service work
        Sleep(1000);
    }

    ReportSvcStatus(SERVICE_STOPPED, NO_ERROR, 0);
}

void WINAPI SvcCtrlHandler(DWORD dwCtrl)
{
    switch (dwCtrl)
    {
    case SERVICE_CONTROL_STOP:
        ReportSvcStatus(SERVICE_STOP_PENDING, NO_ERROR, 0);
        SetEvent(ghSvcStopEvent);
        return;

    default:
        break;
    }
}

void ReportSvcStatus(DWORD dwCurrentState, DWORD dwWin32ExitCode, DWORD dwWaitHint)
{
    static DWORD dwCheckPoint = 1;

    gSvcStatus.dwCurrentState = dwCurrentState;
    gSvcStatus.dwWin32ExitCode = dwWin32ExitCode;
    gSvcStatus.dwWaitHint = dwWaitHint;

    gSvcStatus.dwControlsAccepted = (dwCurrentState == SERVICE_RUNNING) ? SERVICE_ACCEPT_STOP : 0;
    gSvcStatus.dwCheckPoint = (dwCurrentState == SERVICE_RUNNING || dwCurrentState == SERVICE_STOPPED) ? 0 : dwCheckPoint++;

    SetServiceStatus(gSvcStatusHandle, &gSvcStatus);
}

void SvcReportEvent(LPTSTR szFunction)
{
    HANDLE hEventSource = RegisterEventSource(NULL, SVCNAME);
    if (hEventSource)
    {
        TCHAR Buffer[80];
        StringCchPrintf(Buffer, 80, TEXT("%s failed with %d"), szFunction, GetLastError());

        LPCTSTR lpszStrings[2] = { SVCNAME, Buffer };
        ReportEvent(hEventSource, EVENTLOG_ERROR_TYPE, 0, 0, NULL, 2, 0, lpszStrings, NULL);

        DeregisterEventSource(hEventSource);
    }
}

void HandleError(const TCHAR* msg, DWORD errorCode)
{
    _tprintf(TEXT("%s failed with error %d\\n"), msg, errorCode);
    SvcReportEvent((LPTSTR)msg);
}
